@startuml
left to right direction
skinparam packageStyle rectangle
actor "Гость" as Guest
actor "Администратор" as Admin

rectangle "Сервис бронирования «Сладкие сны»" {
  usecase "Просмотр контента сайта" as UC1
  usecase "Просмотр каталога номеров" as UC2
  usecase "Фильтрация по категории,\nцене, количеству мест" as UC3
  usecase "Бронирование номера" as UC4
  usecase "Ввод данных\n(ФИО, телефон, email, даты)" as UC5
  usecase "Проверка занятости дат" as UC6
  usecase "Авторизация" as UC7
  usecase "Просмотр заявок" as UC8
  usecase "Изменение статуса заявки\n(Одобрена / Отклонена)" as UC9
  usecase "Удаление заявки" as UC10
  usecase "Управление каталогом номеров" as UC11
  usecase "Добавление номера" as UC12
  usecase "Редактирование номера" as UC13
  usecase "Удаление номера" as UC14
}

Guest --> UC1
Guest --> UC2
Guest --> UC4
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11

UC3 .up.> UC2 : <<extend>>
UC4 .> UC5 : <<include>>
UC4 .> UC6 : <<include>>
UC8 .up.> UC7 : <<include>>
UC9 .up.> UC8 : <<extend>>
UC10 .up.> UC8 : <<extend>>
UC12 .up.> UC11 : <<extend>>
UC13 .up.> UC11 : <<extend>>
UC14 .up.> UC11 : <<extend>>
@enduml
